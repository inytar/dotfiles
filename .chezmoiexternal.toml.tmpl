[".vim/autoload/plug.vim"]
    type = "file"
    url = "https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim"
    refreshPeriod = "672h"
{{- if eq .chezmoi.os "darwin" }}
["Library/Fonts/Meslo"]
{{- else }}
[".local/share/fonts/Meslo"]
# TODO: Run fc-cache after installing the font
{{- end }}
    type = "archive"
    url = "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/Meslo.tar.xz"
    refreshPeriod = "672h"
    extact = true
{{- if eq .chezmoi.os "darwin" }}
[".iterm2_shell_integration.zsh"]
    type = "file"
    url = "https://iterm2.com/shell_integration/zsh"
    refreshPeriod = "672h"
[".iterm2"]
    type = "archive"
    url = "https://github.com/gnachman/iTerm2-shell-integration/archive/refs/heads/main.zip"
    include = ["iTerm2-shell-integration-main/utilities/*"]
    stripComponents = 2
    extact = true
    refreshPeriod = "672h"
{{- end }}
[".local/share/zim/zimfw.zsh"]
    type = "file"
    url = "https://github.com/zimfw/zimfw/releases/latest/download/zimfw.zsh"
    refreshPeriod = "672h"
