{{- range $plug_loc := list ".vim/autoload/plug.vim" ".config/nvim/autoload/plug.vim" }}
["{{ $plug_loc }}"]
    type = "file"
    url = "https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim"
    refreshPeriod = "672h"
{{- end }}
{{- range $font := .nerdFonts }}
{{- if eq $.chezmoi.os "darwin" }}
["Library/Fonts/{{ $font }}"]
{{- else }}
[".local/share/fonts/{{ $font }}"]
{{- end }}
    type = "archive"
    url = "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/{{ $font }}.tar.xz"
    refreshPeriod = "672h"
    extact = true
{{- end }}
{{- if eq .chezmoi.os "darwin" }}
{{- end }}
[".local/share/zim/zimfw.zsh"]
    type = "file"
    url = "https://github.com/zimfw/zimfw/releases/latest/download/zimfw.zsh"
    refreshPeriod = "672h"
