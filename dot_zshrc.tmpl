HISTFILE=~/.histfile
HISTSIZE=10000
SAVEHIST=10000
setopt autocd beep extendedglob nomatch notify
bindkey -e
export EDITOR={{ .chezmoi.config.edit.command }}

zstyle :compinstall filename '{{ .chezmoi.homeDir }}/.zshrc'

if [ "$TERM_PROGRAM" != "Apple_Terminal" ]; then
  eval "$(oh-my-posh init zsh --config {{ .chezmoi.homeDir }}/.config/ohmyposh/basic.toml)"
fi

{{- if eq .chezmoi.os "darwin" }}
test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"
{{- range glob ".iterm2/*" }}
alias {{ . | base }}=${HOME}/{{ . }}
{{- end }}
{{- end }}
{{- if eq .email "pieter.mulder@wooga.net" }}
export NODE_EXTRA_CA_CERTS="/Library/Application Support/Playtika Corp. IT/Certs/Playtika-SCA.pem"
. /opt/homebrew/opt/asdf/libexec/asdf.sh
export GOPATH="${HOME}/go"
{{- end }}

source ${ZIM_HOME}/init.zsh

source ${ZIM_HOME}/modules/zsh-defer/zsh-defer.plugin.zsh

# User specific aliases and functions
if [ -d {{ .chezmoi.homeDir }}/.zshrc.d ]; then
  for rc in {{ .chezmoi.homeDir }}/.zshrc.d/*; do
    if [ -f "$rc" ]; then
      . "$rc"
    fi
  done
  unset rc
fi
