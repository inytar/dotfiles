#!/bin/bash
set -euo pipefail
IFS=$'\n\t'

{{ if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.variantID "silverblue") -}}

rpm-ostree install --assumeyes --apply-live --idempotent vim zsh git gopass gopass-jsonapi fzf ripgrep direnv
curl -s https://ohmyposh.dev/install.sh | bash -s
{{ end -}}
{{ if eq .chezmoi.os "darwin" }}

/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

brew bundle --file=/dev/stdin <<EOF
brew "vim"
cask "kitty"
brew "git"
brew "gh"
brew "fzf"
brew "ripgrep"
brew "oh-my-posh"
brew "direnv"
brew "chruby"
brew "uv"
brew "k9s"
cask "docker/tap/sbx", trusted: true
brew "fluxcd/tap/flux", trusted: true
brew "hashicorp/tap/terraform", trusted: true
brew "helm@3"
brew "sops"
brew "kafkactl"
brew "yq"
brew "awscli"
brew "just"
cask "firefox"
EOF
{{ end -}}
